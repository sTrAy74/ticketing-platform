{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "DATABASE_URL",
    "ADMIN_API_KEY",
    "ENABLE_TIME_SIMULATION",
    "PRICING_WEIGHT_TIME",
    "PRICING_WEIGHT_DEMAND",
    "PRICING_WEIGHT_INVENTORY",
    "API_PORT",
    "RUN_DB_TESTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "dependsOn": [],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
