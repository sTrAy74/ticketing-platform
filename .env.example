# Copy to ".env" in repo root OR export vars in your shell.

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing

API_PORT=3001
ADMIN_API_KEY=please-change-me
ENABLE_TIME_SIMULATION=true

PRICING_WEIGHT_TIME=1
PRICING_WEIGHT_DEMAND=1
PRICING_WEIGHT_INVENTORY=1

# Web (same host as browser + server-side calls)
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
